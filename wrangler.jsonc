{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "millonroutines",
  "account_id": "3ae049368365a35bb4f2ba6a658f1c9a",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "millionroutines-waitlist",
      "database_id": "85c2dfb3-b5ad-492b-bc05-332a45d0a470",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "millionroutines.com",
      "custom_domain": true
    },
    {
      "pattern": "www.millionroutines.com",
      "custom_domain": true
    }
  ],
  "preview_urls": false
}
